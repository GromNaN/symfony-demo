{% extends "base.html.twig" %}

{% block title %}Users{% endblock %}

{% block body %}
    <h2>Users</h2>

    {% if users is empty %}
        <div class="empty-state">
            <p>No users found.</p>
            <a href="{{ path('user_new') }}" class="btn btn-primary">Create First User</a>
        </div>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>
                            <code>{{ user.email|slice(0, 20) }}...</code>
                            <span class="form-help">(encrypted)</span>
                        </td>
                        <td>
                            <code>{{ user.firstName|slice(0, 20) }}...</code>
                            <span class="form-help">(encrypted)</span>
                        </td>
                        <td>
                            <code>{{ user.lastName|slice(0, 20) }}...</code>
                            <span class="form-help">(encrypted)</span>
                        </td>
                        <td>
                            <div class="actions">
                                <a href="{{ path('user_edit', { id: user.id }) }}" class="btn btn-secondary">Edit</a>
                                <form method="POST" action="{{ path('user_delete', { id: user.id }) }}" style="display:inline;">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

