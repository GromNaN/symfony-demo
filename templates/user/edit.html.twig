{% extends "base.html.twig" %}

{% block title %}Edit User #{{ user.id }}{% endblock %}

{% block body %}
    <h2>Edit User #{{ user.id }}</h2>
    <p style="margin: 20px 0; color: #666;">
        All sensitive fields (email, name) are encrypted before storage.
        <br>
        <strong>Password</strong> is optional - leave blank to keep current password.
    </p>

    {{ form_start(form) }}
        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            {% if form.email.vars.help %}
                <div class="form-help">{{ form.email.vars.help }}</div>
            {% endif %}
            {% if form.email.vars.errors %}
                <div class="form-error">
                    {% for error in form.email.vars.errors %}
                        {{ error.message }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="form-group">
            {{ form_label(form.firstName) }}
            {{ form_widget(form.firstName) }}
            {% if form.firstName.vars.help %}
                <div class="form-help">{{ form.firstName.vars.help }}</div>
            {% endif %}
            {% if form.firstName.vars.errors %}
                <div class="form-error">
                    {% for error in form.firstName.vars.errors %}
                        {{ error.message }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="form-group">
            {{ form_label(form.lastName) }}
            {{ form_widget(form.lastName) }}
            {% if form.lastName.vars.help %}
                <div class="form-help">{{ form.lastName.vars.help }}</div>
            {% endif %}
            {% if form.lastName.vars.errors %}
                <div class="form-error">
                    {% for error in form.lastName.vars.errors %}
                        {{ error.message }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update User</button>
            <a href="{{ path('user_list') }}" class="btn btn-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}

